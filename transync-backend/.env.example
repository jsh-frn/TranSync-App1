DB_HOST=localhost
DB_NAME=transync
DB_USER=root
DB_PASS=

# Public base URL of this backend (trailing slash optional, normalized at
# runtime) — used only where a document/file URL must be returned as a
# fully-qualified link (verify.php, pending_operator_applications.php).
# Set this to your real domain in production, e.g.
# https://api.transync.app/TranSync-App/transync-backend
BACKEND_PUBLIC_URL=http://localhost/TranSync-App/transync-backend

# AWS Rekognition — leave both blank to stay in demo mode (synthetic,
# clearly-fake face-match/liveness results, no AWS account needed). Fill in
# real credentials only from your own AWS IAM console; never hardcode a real
# key in config/rekognition.php.
AWS_REKOGNITION_ACCESS_KEY=
AWS_REKOGNITION_SECRET_KEY=
AWS_REKOGNITION_REGION=ap-southeast-1

# PayMongo — set your sk_test_/pk_test_ sandbox keys or sk_live_/pk_live_ live
# keys here. No hardcoded fallback exists in config/paymongo.php (secrets must
# never live in source), so leaving these blank disables PayMongo payments.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# IPROG SMS — leave blank to use this project's own working token
# (config/sms.php). No demo mode exists for this one (every self-
# registration screen hard-requires a real OTP send), so only override this
# once you have a new token from https://www.iprogsms.com's dashboard.
IPROG_SMS_API_TOKEN=

# Text the operator (via IPROG SMS) when one of their drivers taps EMERGENCY.
# Off by default so testing never texts a real number / spends SMS credit.
# Set to 1 to enable (needs IPROG_SMS_API_TOKEN above and a real operators.phone).
EMERGENCY_SMS_ENABLED=0
